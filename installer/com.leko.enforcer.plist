<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.leko.enforcer</string>
  <key>ProgramArguments</key>
  <array>
    <string>__LEKO_BIN__</string>
    <string>agent</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/com.leko.enforcer.err.log</string>
  <key>StandardOutPath</key>
  <string>/tmp/com.leko.enforcer.out.log</string>
</dict>
</plist>
