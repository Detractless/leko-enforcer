{
  "id": "google_search",
  "name": "Google Search Adapter",
  "url_patterns": [
    "*://*.google.com/search*",
    "*://google.com/search*",
    "*://*.google.*/search*",
    "*://google.*/search*"
  ],
  "selectors": {
    "query": [
      "textarea[name=\"q\"]",
      "input[name=\"q\"]"
    ],
    "results": [
      "#search .g",
      "#rso .MjjYud",
      "#rso > div"
    ],
    "title": [
      "h3"
    ],
    "snippet": [
      "[data-sncf]",
      ".VwiC3b",
      ".IsZvec",
      ".yXK7lf"
    ],
    "knowledge_panel": [
      "#rhs",
      ".kp-wholepage",
      ".kp-blk",
      "[data-attrid]"
    ]
  },
  "page_type": "search_results"
}