{
  "manifest_version": 3,
  "name": "Leko Enforcer Blocker",
  "version": "0.1.0",
  "description": "Real-time page evaluation and content blocking backed by local WAE daemon.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "inspection_curtain.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "chunk_scanner.js",
        "adapter_runner.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui/blocked.html",
        "ui/blocked.css",
        "adapters/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
