{
  "manifest_version": 3,
  "name": "Leko Enforcer Collection",
  "version": "0.1.0",
  "description": "Optional page-text collection for the Leko Enforcer research dataset.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Collection settings" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
